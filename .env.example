# Starry Docker 部署配置（复制为 .env）

# 镜像来源：默认本地构建（docker compose build），STARRY_TAG 会写进二进制版本号
STARRY_TAG=1.0.3
STARRY_IMAGE=starry:local

# 对外端口（宿主机 → 容器）
STARRY_PORT=8787        # 控制台
STARRY_PROXY_PORT=8788  # MITM 抓包代理

# 数据库（compose 内置 postgres 用；用外部库时改 STARRY_PG_DSN）
POSTGRES_USER=starry
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=starry

# 国内网络拉 Go 模块慢时可换镜像源
# GOPROXY=https://goproxy.cn,direct

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STARRY_LLM_PROVIDER=
STARRY_LLM_MODEL=
STARRY_LLM_BASE_URL=
STARRY_LLM_PROXY=